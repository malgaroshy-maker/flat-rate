# Gemini API key (required for online mode — get from aistudio.google.com)
GEMINI_API_KEY=

# Cloud model names
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Embedding source: "gemini" (cloud) or "local" (sentence-transformers)
# Auto-detects corpus model from ChromaDB metadata
EMBEDDING_SOURCE=gemini

# HuggingFace token (optional — for higher rate limits on model downloads)
HF_TOKEN=

# Local LLM backend: "llamacpp" (port 8080, OpenAI-compatible) or "ollama" (port 11434)
LOCAL_LLM_BACKEND=llamacpp
LOCAL_LLM_HOST=http://localhost:8080
LOCAL_LLM_MODEL=gemma-4-e4b-it

# Local embedding model (offline fallback, via sentence-transformers)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Force local mode (overrides cloud even if API key present)
FORCE_LOCAL=false

# ChromaDB storage path
CHROMA_PERSIST_DIR=../chroma_db

# Application
DATA_DIR=../
